BLACKLISTED_PLAYERS=
SCORING_DIAGNOSTICS=false

# ── Historical source weights (one per entry in historical-sources.json) ────
# All optional; defaults come from the registry. Tune via `bun run optimize-weights-v7`.
# WEIGHT_HIST_12M_TOP50_LAN=0.75
# WEIGHT_HIST_12M_TOP20_LAN=1
# WEIGHT_HIST_6M_TOP50_MVP=1.25
# WEIGHT_HIST_6M_TOP20_MVP=1.4
# WEIGHT_HIST_3M_TOP50_LAN=1.5
# WEIGHT_HIST_3M_TOP20_MVP=1.75

# ── Player-level weights ────────────────────────────────────────────────────
# cardRatingBenefit is the card rating's share of the projection blend — it is
# the whole projection for players with no historical coverage, negligible
# otherwise.
# WEIGHT_CARD_RATING_BENEFIT=0.25
# WEIGHT_TOP_TEAM_RANK_BENEFIT=0.5
# WEIGHT_CT_VS_T_RATING_IMBALANCE_PENALTY=0.2
# WEIGHT_AWP_PER_ROUND_WEIGHT=0
# WEIGHT_DEATH_PENALTY_WEIGHT=0
# WEIGHT_PRICE_EFFICIENCY_BENEFIT=0

# ── Lineup-level weights ────────────────────────────────────────────────────
# Stack correlation rewards same-team pairs and scales up for top-ranked teams.
# WEIGHT_STACK_CORRELATION_BENEFIT=0.35
# Field-split penalties (same side of the bracket/draw concentration).
# 4+ players on one side is a big penalty; 5 is near-forbidden ((n−3) multiplier).
# WEIGHT_FIELD_SIDE_3_PLAYER_PENALTY=0.25
# WEIGHT_FIELD_SIDE_4PLUS_PLAYER_PENALTY=1.1
# WEIGHT_FIELD_SIDE_CROSS_TEAM_PENALTY=0.2
