BLACKLISTED_PLAYERS=
SCORING_DIAGNOSTICS=false

# ── Historical source weights (one per entry in historical-sources.json) ────
# All optional; defaults come from the registry. Tune via `bun run optimize-weights-v7`.
# WEIGHT_HIST_1M_TOP30_MVP=1
# WEIGHT_HIST_3M_TOP20_MVP=1.5
# WEIGHT_HIST_3M_TOP50_LAN=1.25
# WEIGHT_HIST_6M_TOP30_LAN=1.25
# WEIGHT_HIST_12M_TOP10_LAN=1
# WEIGHT_HIST_12M_TOP20_LAN=1.25
# WEIGHT_HIST_12M_TOP30_LAN=1
# WEIGHT_HIST_12M_TOP50_LAN=0.75

# ── Player-level weights ────────────────────────────────────────────────────
# WEIGHT_CARD_RATING_BENEFIT=0.25
# WEIGHT_TOP_TEAM_RANK_BENEFIT=0.5
# WEIGHT_AWPER_ROLE_BENEFIT=0
# WEIGHT_LOW_DEATH_RATE_BENEFIT=0
# WEIGHT_CT_VS_T_RATING_IMBALANCE_PENALTY=0.5
# WEIGHT_AWP_PER_ROUND_WEIGHT=0
# WEIGHT_DEATH_PENALTY_WEIGHT=0
# WEIGHT_PRICE_EFFICIENCY_BENEFIT=0

# ── Lineup-level weights ────────────────────────────────────────────────────
# Stack correlation rewards same-team pairs; stack rank favors top-ranked stacks.
# WEIGHT_STACK_CORRELATION_BENEFIT=0.5
# WEIGHT_TOP_RANKED_TEAM_STACK_BENEFIT=0.75
# Field-split penalties (same side of the bracket/draw concentration).
# WEIGHT_FIELD_SIDE_3_PLAYER_PENALTY=0.5
# WEIGHT_FIELD_SIDE_4PLUS_PLAYER_PENALTY=0.75
# WEIGHT_FIELD_SIDE_CROSS_TEAM_PENALTY=0.25

# ── Shrinkage (empirical-Bayes on short-window ratings) ─────────────────────
# SHRINKAGE_ENABLED=true
# SHRINKAGE_LEAGUE_PRIOR=1.06
# SHRINKAGE_STRENGTH=1

# ── Thresholds for gated benefits ───────────────────────────────────────────
# THRESHOLD_AWPER_ROLE_MIN_AWP_PER_ROUND=0.25
# THRESHOLD_LOW_DEATH_RATE_MAX_DEATHS_PER_ROUND=0.6
